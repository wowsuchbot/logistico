{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@logistics/shared": ["./packages/shared/src"],
      "@logistics/shared/*": ["./packages/shared/src/*"]
    }
  },
  "exclude": ["node_modules", "apps/api"]
}
